# Cezar Orchestrator & Cockpit Environment Template
# Skopiuj ten plik do .env i uzupełnij swoje poświadczenia:
# cp .env.example .env

# Dostęp do panelu WWW (HTTP Basic Auth za Traefikiem)
CEZAR_USER=tkogut
CEZAR_PASSWORD=zmien_na_bezpieczne_haslo
# Format: user:$$apr1$$hash wygenerowany przez update-password.sh
CEZAR_BASIC_AUTH=tkogut:$$apr1$$hash_wygenerowany_przez_skrypt

# Klucze LLM Providerów dla runnera pi i cezar
OPENROUTER_API_KEY=sk-or-v1-twoj-klucz-openrouter
ANTHROPIC_API_KEY=sk-ant-twoj-klucz-anthropic

# Git identity wewnątrz kontenera cezar
GIT_USER_NAME=tkogut
GIT_USER_EMAIL=tkogut9@gmail.com
GIT_DEFAULT_BRANCH=master
